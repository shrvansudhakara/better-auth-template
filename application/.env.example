# ====================
# AUTHENTICATION
# ====================
# Authentication is handled by Better-auth
BETTER_AUTH_SECRET="your-better-auth-secret" # Generate secret key with: openssl rand -base64 32
BETTER_AUTH_URL="your-base-url" # Base URL, use http://localhost:3000 locally

# ====================
# OAUTH CONFIGURATION
# ====================
# These credentials allow users to log in using GitHub or Google.
# Get them from:
# - GitHub: https://github.com/settings/developers
# - Google: https://console.cloud.google.com/apis/credentials
# ---- GitHub OAuth ----
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
# ---- Google OAuth ----
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
